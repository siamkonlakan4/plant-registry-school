function listUsers(){return rows('Users').map(({__row,...u})=>u)}
function saveUser(actor,x,id){return lock(()=>{const email=str(x.email,254).toLowerCase(),full_name=str(x.full_name,150),role=x.role,active=x.active===true||x.active==='true';if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)||!full_name||!['admin','staff'].includes(role))throw apiError('INVALID_INPUT','ข้อมูลผู้ใช้ไม่ถูกต้อง');const before=id?rows('Users').find(u=>u.user_id===id):null;if(id&&!before)throw apiError('NOT_FOUND','ไม่พบผู้ใช้');if(rows('Users').some(u=>u.email===email&&u.user_id!==id))throw apiError('DUPLICATE','อีเมลซ้ำ');if(before?.role==='admin'&&(!active||role!=='admin'))lastAdmin(before);const after=before?patch('Users',before,{email,full_name,role,active,updated_at:now()}):append('Users',{user_id:uid('USR'),email,full_name,role,active,created_at:now(),updated_at:now()});audit(before?'update':'create','User',after.user_id,actor,before,after);return after})}
function lastAdmin(user){if(rows('Users').filter(u=>u.role==='admin'&&String(u.active)==='true'&&u.user_id!==user.user_id).length===0)throw apiError('LAST_ADMIN','ไม่สามารถปิดสิทธิ์ผู้ดูแลคนสุดท้าย')}
function removeUser(actor,id){return lock(()=>{const u=rows('Users').find(x=>x.user_id===id);if(!u)throw apiError('NOT_FOUND','ไม่พบผู้ใช้');if(u.role==='admin')lastAdmin(u);patch('Users',u,{active:false,updated_at:now()});audit('deactivate','User',id,actor,u,{active:false});return {user_id:id}})}

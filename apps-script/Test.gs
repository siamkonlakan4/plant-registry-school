function testBootstrap(){const r=bootstrapSystem();if(!r.success||Object.keys(HEADERS).some(k=>!sheet(k)))throw Error('bootstrap failed');return true}
function testCrud(){const u={email:cfg('ADMIN_EMAIL'),full_name:'Test',role:'admin'};const id='TEST-'+Utilities.getUuid().slice(0,6);const p=createPlant(u,{plant_code:id,common_name:'ทดสอบ',scientific_name:'Test plant',family:'TEST',habit:'ไม้ต้น',key_features:'ทดสอบ',location:'ทดสอบ',quantity:1,status:'draft'});if(plantById(p.plant_id).plant_code!==id)throw Error('create failed');updatePlant(u,p.plant_id,{...p,common_name:'ทดสอบแก้ไข'});deletePlant(u,p.plant_id);return true}

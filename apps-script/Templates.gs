function templateData(name,type){const base=[{kind:'rect',x:0,y:0,width:400,height:600,fill:'#ffffff'},{kind:'text',x:24,y:25,width:350,height:50,text:'{{school_name}}',fontSize:22,fill:'#6246B5'},{kind:'text',x:24,y:380,width:340,height:50,text:'{{common_name}}',fontSize:34,fill:'#322B42'},{kind:'text',x:24,y:435,width:340,height:32,text:'{{scientific_name}}',fontSize:18,italic:true,fill:'#766F85'},{kind:'text',x:24,y:475,width:330,height:28,text:'{{family}} · {{plant_code}}',fontSize:16,fill:'#322B42'},{kind:'qr',x:265,y:505,width:105,height:105}];if(type==='qr')base.splice(2,0,{kind:'text',x:24,y:130,width:350,height:40,text:'{{plant_code}}',fontSize:26,fill:'#6246B5'}),base[base.length-1]={kind:'qr',x:100,y:145,width:200,height:200};else base.splice(2,0,{kind:'image',x:24,y:82,width:350,height:275,source:'plant_image'});return {version:1,name,width_mm:100,height_mm:150,nodes:base}}
function templates(){return rows('Label_Templates').filter(t=>String(t.is_active)==='true').map(({__row,...t})=>t)}
function templateInput(x){const name=str(x.template_name,100),description=str(x.description,400),width_mm=Number(x.width_mm),height_mm=Number(x.height_mm),json=typeof x.template_json==='string'?JSON.parse(x.template_json):x.template_json;if(!name||![100,120].includes(width_mm)||![150,180].includes(height_mm)||!json||!Array.isArray(json.nodes)||json.nodes.length>100)throw apiError('INVALID_INPUT','ข้อมูล Template ไม่ถูกต้อง');json.nodes.forEach(n=>{if(!['rect','circle','line','text','image','qr','icon'].includes(n.kind)||!Number.isFinite(Number(n.x))||!Number.isFinite(Number(n.y)))throw apiError('INVALID_INPUT','วัตถุป้ายไม่ถูกต้อง');if(n.kind==='qr'&&Math.min(Number(n.width),Number(n.height))*width_mm/400<25)throw apiError('INVALID_INPUT','QR ต้องมีขนาดอย่างน้อย 25 มม.')});return {template_name:name,description,width_mm,height_mm,orientation:'portrait',template_json:JSON.stringify(json),updated_at:now()}}
function saveTemplate(user,x,id){return lock(()=>{const d=templateInput(x),before=id?rows('Label_Templates').find(t=>t.template_id===id):null;if(id&&!before)throw apiError('NOT_FOUND','ไม่พบ Template');const t=before?patch('Label_Templates',before,d):append('Label_Templates',{...d,template_id:uid('TPL'),is_active:true,is_default:false,created_by:user.email,created_at:now()});audit(before?'update':'create','Template',t.template_id,user,before,t);return t})}
function deleteTemplate(user,id){return lock(()=>{const t=rows('Label_Templates').find(x=>x.template_id===id);if(!t)throw apiError('NOT_FOUND','ไม่พบ Template');patch('Label_Templates',t,{is_active:false});audit('delete','Template',id,user,t,{is_active:false});return {template_id:id}})}

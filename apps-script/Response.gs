function apiError(code,message){const e=new Error(message);e.code=code;return e}
function safe(fn){try{return {success:true,data:fn(),meta:{at:now()}}}catch(e){console.error('API error '+(e.code||'INTERNAL')+' '+String(e.message).slice(0,200));return {success:false,error:{code:e.code||'INTERNAL',message:e.code?e.message:'ไม่สามารถดำเนินการได้ กรุณาลองใหม่'}}}}
function jsonp(result,callback){if(!/^plantcb_[a-f0-9]{32}$/.test(callback||''))return ContentService.createTextOutput('Invalid callback').setMimeType(ContentService.MimeType.TEXT);return ContentService.createTextOutput(callback+'('+JSON.stringify(result).replace(/</g,'\\u003c')+');').setMimeType(ContentService.MimeType.JAVASCRIPT)}
function postReply(result,id){const match=cfg('FRONTEND_URL').match(/^https?:\/\/[^/]+/);const target=match?match[0]:'';const payload=JSON.stringify({id,result}).replace(/</g,'\\u003c').replace(/\u2028|\u2029/g,'');const html='<!doctype html><meta charset="utf-8"><script>top.postMessage('+payload+','+JSON.stringify(target)+')<\/script>';return HtmlService.createHtmlOutput(html).setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)}

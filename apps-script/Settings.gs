function setting(k){return rows('Settings').find(r=>r.setting_key===k)?.setting_value||''}
function publicSettings(){const o={};for(const k of ['system_name','school_name','system_description','school_logo_url','primary_color','max_images_per_plant','public_recorder_visibility','frontend_url'])o[k]=setting(k);return o}
function allSettings(){const o={};rows('Settings').forEach(r=>o[r.setting_key]=r.setting_value);for(const k of ['drive_root_folder_id','plant_images_folder_id','logo_folder_id'])if(o[k])o[k]=o[k].slice(0,4)+'…'+o[k].slice(-4);o.spreadsheet_id=cfg('SPREADSHEET_ID').slice(0,4)+'…'+cfg('SPREADSHEET_ID').slice(-4);return o}
function saveSettings(user,x){return lock(()=>{const allowed=['system_name','school_name','system_description','admin_name','primary_color','max_images_per_plant','default_label_width_mm','default_label_height_mm','public_recorder_visibility'];for(const k of allowed)if(x[k]!==undefined){let value=str(x[k],500);if(k==='primary_color'&&!/^#[0-9a-f]{6}$/i.test(value))throw apiError('INVALID_INPUT','สีไม่ถูกต้อง');if(k==='max_images_per_plant'&&!['3','4','5'].includes(value))throw apiError('INVALID_INPUT','จำนวนรูปไม่ถูกต้อง');const r=rows('Settings').find(y=>y.setting_key===k);if(r)patch('Settings',r,{setting_value:value,updated_at:now(),updated_by:user.email})}if(x.school_logo){const b=x.school_logo;if(!/^image\/(png|jpeg|webp)$/.test(b.mime)||String(b.data).length>8e6)throw apiError('INVALID_INPUT','โลโก้ไม่ถูกต้อง');const bytes=Utilities.base64Decode(b.data);if(bytes.length>5*1024*1024)throw apiError('INVALID_INPUT','โลโก้เกินขนาด');const f=DriveApp.getFolderById(cfg('LOGO_FOLDER_ID')).createFile(Utilities.newBlob(bytes,b.mime,'school-logo-'+Utilities.formatDate(new Date(),'Asia/Bangkok','yyyyMMdd')+'.'+b.mime.split('/')[1]));f.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);for(const [k,v] of [['school_logo_file_id',f.getId()],['school_logo_url','https://drive.google.com/thumbnail?id='+f.getId()+'&sz=w400']]){const r=rows('Settings').find(y=>y.setting_key===k);patch('Settings',r,{setting_value:v,updated_at:now(),updated_by:user.email})}append('Media',{file_id:f.getId(),file_name:f.getName(),mime_type:b.mime,size_bytes:bytes.length,uploaded_by:user.email,uploaded_at:now(),is_deleted:false})}audit('settings','Settings','global',user,null,x);return allSettings()})}

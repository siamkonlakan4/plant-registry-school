function bootstrapSystem(){return lock(()=>{const admin=cfg('ADMIN_EMAIL'),frontend=cfg('FRONTEND_URL');if(!admin||!frontend||!cfg('STAFF_DOMAIN'))throw Error('Set ADMIN_EMAIL, STAFF_DOMAIN, FRONTEND_URL in Script Properties first');let ss=cfg('SPREADSHEET_ID')?SpreadsheetApp.openById(cfg('SPREADSHEET_ID')):SpreadsheetApp.create('Plant Registry School');PROPS().setProperty('SPREADSHEET_ID',ss.getId());Object.entries(HEADERS).forEach(([name,headers])=>{let s=ss.getSheetByName(name)||ss.insertSheet(name);if(s.getLastRow()===0){s.appendRow(headers);s.setFrozenRows(1);s.getRange(1,1,1,headers.length).setBackground('#8B6FDF').setFontColor('#FFFFFF').setFontWeight('bold');s.autoResizeColumns(1,headers.length);if(name==='Plants'){s.getRange('U2:U').setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['draft','pending','published','archived']).build());s.getRange('X2:X').setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['not_printed','printed','installed','damaged','replaced']).build())}if(name==='Users')s.getRange('D2:D').setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['admin','staff']).build())}});let root=cfg('DRIVE_ROOT_FOLDER_ID')?DriveApp.getFolderById(cfg('DRIVE_ROOT_FOLDER_ID')):DriveApp.createFolder('Plant-Registry-System');PROPS().setProperty('DRIVE_ROOT_FOLDER_ID',root.getId());for(const [key,name] of [['SYSTEM_FOLDER_ID','00_System'],['LOGO_FOLDER_ID','01_School-Logo'],['PLANT_IMAGES_FOLDER_ID','02_Plant-Images'],['TEMPLATES_FOLDER_ID','03_Label-Templates'],['EXPORTS_FOLDER_ID','04_Label-Exports'],['ARCHIVE_FOLDER_ID','99_Archive']]){const it=root.getFoldersByName(name);PROPS().setProperty(key,(it.hasNext()?it.next():root.createFolder(name)).getId())}const defaults={system_name:'ระบบทะเบียนพรรณไม้โรงเรียน',school_name:'โรงเรียนสยามกลการ 4',system_description:'แหล่งเรียนรู้พรรณไม้ในโรงเรียน',admin_name:cfg('ADMIN_NAME')||'',school_logo_file_id:'',school_logo_url:'',primary_color:'#8B6FDF',max_images_per_plant:'5',default_label_width_mm:'100',default_label_height_mm:'150',drive_root_folder_id:root.getId(),plant_images_folder_id:cfg('PLANT_IMAGES_FOLDER_ID'),logo_folder_id:cfg('LOGO_FOLDER_ID'),public_recorder_visibility:'false',frontend_url:frontend,apps_script_webapp_url:cfg('WEBAPP_URL')};for(const [k,v] of Object.entries(defaults))if(!rows('Settings').some(x=>x.setting_key===k))append('Settings',{setting_key:k,setting_value:v,updated_at:now(),updated_by:'bootstrap'});if(!rows('Users').some(u=>u.email===admin))append('Users',{user_id:uid('USR'),email:admin,full_name:cfg('ADMIN_NAME')||admin,role:'admin',active:true,created_at:now(),updated_at:now()});const habits=['ไม้ต้น','ไม้พุ่ม','ไม้เลื้อย','ไม้ล้มลุก','ไม้คลุมดิน','ปาล์ม','เฟิร์น','หญ้า','พืชน้ำ'];habits.forEach((v,i)=>{if(!rows('Lookup_Habits').some(x=>x.value===v))append('Lookup_Habits',{value:v,active:true,sort_order:i+1})});['หน้าอาคารเรียน','สนามหน้าโรงเรียน','สวนหย่อม','ข้างสนามกีฬา','แปลงสมุนไพร'].forEach((v,i)=>{if(!rows('Lookup_Locations').some(x=>x.value===v))append('Lookup_Locations',{value:v,active:true,sort_order:i+1})});[['TEMPLATE-001','Botanical Classic','classic'],['TEMPLATE-002','QR Focus','qr'],['TEMPLATE-003','Plant Gallery','gallery']].forEach(([id,name,type])=>{if(!rows('Label_Templates').some(t=>t.template_id===id))append('Label_Templates',{template_id:id,template_name:name,description:'ป้ายเริ่มต้น',width_mm:100,height_mm:150,orientation:'portrait',template_json:JSON.stringify(templateData(name,type)),is_default:true,is_active:true,created_by:admin,created_at:now(),updated_at:now()})});if(!rows('Activity_Log').length)audit('bootstrap','System','init',null,null,{spreadsheet_created:true});return {success:true,spreadsheet_id:ss.getId(),drive_root_folder_id:root.getId(),sheets:Object.keys(HEADERS)}})}

const HEADERS={Plants:'plant_id plant_code common_name scientific_name family habit key_features location zone quantity latitude longitude cover_image_file_id cover_image_url image_file_ids_json image_urls_json recorder_email recorder_name created_at updated_at status qr_url qr_last_generated_at label_status label_printed_at label_installed_at notes is_deleted'.split(' '),Users:'user_id email full_name role active created_at updated_at last_login_at'.split(' '),Settings:'setting_key setting_value updated_at updated_by'.split(' '),Label_Templates:'template_id template_name description width_mm height_mm orientation template_json thumbnail_file_id thumbnail_url is_default is_active created_by created_at updated_at'.split(' '),Label_Print_Log:'print_log_id template_id plant_id plant_code printed_by_email printed_at print_count output_type label_status notes'.split(' '),Activity_Log:'log_id action entity_type entity_id user_email user_name action_at before_json after_json metadata_json'.split(' '),Lookup_Habits:['value','active','sort_order'],Lookup_Locations:['value','active','sort_order'],Media:['file_id','plant_id','file_name','mime_type','size_bytes','source_url','author','license','attribution','uploaded_by','uploaded_at','is_deleted']};
const PROPS=()=>PropertiesService.getScriptProperties();const cfg=k=>PROPS().getProperty(k)||'';const now=()=>new Date().toISOString();const uid=p=>p+'-'+Utilities.getUuid().slice(0,8);
function sheet(name){const id=cfg('SPREADSHEET_ID');if(!id)throw apiError('NOT_SETUP','กรุณารัน bootstrapSystem ก่อน');return SpreadsheetApp.openById(id).getSheetByName(name)}
function rows(name){const s=sheet(name),v=s.getDataRange().getValues(),keys=HEADERS[name];return v.slice(1).filter(a=>a.some(x=>x!=='' )).map((a,i)=>Object.assign({__row:i+2},Object.fromEntries(keys.map((k,j)=>[k,a[j]]))))}
function append(name,obj){const s=sheet(name);s.appendRow(HEADERS[name].map(k=>obj[k]??''));return obj}
function patch(name,row,obj){const s=sheet(name),merged={...row,...obj};s.getRange(row.__row,1,1,HEADERS[name].length).setValues([HEADERS[name].map(k=>merged[k]??'')]);return merged}
function lock(fn){const l=LockService.getScriptLock();l.waitLock(20000);try{return fn()}finally{l.releaseLock()}}

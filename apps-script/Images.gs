function mediaFolder(id){const root=DriveApp.getFolderById(cfg('PLANT_IMAGES_FOLDER_ID')),it=root.getFoldersByName(id);return it.hasNext()?it.next():root.createFolder(id)}
function uploadImages(user,id,images){if(!Array.isArray(images)||images.length<1||images.length>5)throw apiError('INVALID_INPUT','รูปภาพไม่ถูกต้อง');const p=plantById(id);if(user.role!=='admin'&&p.recorder_email!==user.email)throw apiError('FORBIDDEN','ไม่มีสิทธิ์');const ids=JSON.parse(p.image_file_ids_json||'[]'),urls=JSON.parse(p.image_urls_json||'[]');if(ids.length+images.length>5)throw apiError('INVALID_INPUT','รวมรูปภาพได้สูงสุด 5 รูป');const folder=mediaFolder(id);images.forEach((img,i)=>{if(!/^image\/(jpeg|png|webp)$/.test(img.mime)||!/^[-\w.]{1,120}$/.test(img.name)||String(img.data||'').length>8e6)throw apiError('INVALID_INPUT','ไฟล์ไม่ถูกต้อง');const bytes=Utilities.base64Decode(img.data);if(bytes.length>5*1024*1024)throw apiError('INVALID_INPUT','ไฟล์เกิน 5 MB');const signature=bytes.slice(0,12).map(b=>b&255);const valid=img.mime==='image/jpeg'&&signature[0]===255&&signature[1]===216||img.mime==='image/png'&&signature.slice(0,4).join(',')==='137,80,78,71'||img.mime==='image/webp'&&String.fromCharCode(...signature.slice(0,4))==='RIFF'&&String.fromCharCode(...signature.slice(8,12))==='WEBP';if(!valid)throw apiError('INVALID_INPUT','ชนิดไฟล์ไม่ตรงกับข้อมูลภาพ');const f=folder.createFile(Utilities.newBlob(bytes,img.mime,id+'-'+String(ids.length+1).padStart(2,'0')+'.'+(img.mime==='image/jpeg'?'jpg':img.mime.split('/')[1])));f.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);ids.push(f.getId());urls.push('https://drive.google.com/thumbnail?id='+encodeURIComponent(f.getId())+'&sz=w1600');append('Media',{file_id:f.getId(),plant_id:id,file_name:f.getName(),mime_type:img.mime,size_bytes:bytes.length,uploaded_by:user.email,uploaded_at:now(),is_deleted:false})});patch('Plants',plantById(id),{image_file_ids_json:JSON.stringify(ids),image_urls_json:JSON.stringify(urls),cover_image_file_id:ids[0],cover_image_url:urls[0],updated_at:now()});audit('upload','Media',id,user,null,{count:images.length});return {count:images.length}}
function removeImage(user,id,fileId){return lock(()=>{const p=plantById(id);if(user.role!=='admin'&&p.recorder_email!==user.email)throw apiError('FORBIDDEN','ไม่มีสิทธิ์');const ids=JSON.parse(p.image_file_ids_json||'[]'),urls=JSON.parse(p.image_urls_json||'[]'),i=ids.indexOf(fileId);if(i<0)throw apiError('NOT_FOUND','ไม่พบรูป');ids.splice(i,1);urls.splice(i,1);patch('Plants',p,{image_file_ids_json:JSON.stringify(ids),image_urls_json:JSON.stringify(urls),cover_image_file_id:ids[0]||'',cover_image_url:urls[0]||''});const m=rows('Media').find(x=>x.file_id===fileId);if(m)patch('Media',m,{is_deleted:true});if(user.role==='admin')DriveApp.getFileById(fileId).setTrashed(true);audit('remove','Media',fileId,user,null,{plant_id:id});return {file_id:fileId}})}

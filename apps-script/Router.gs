function publicRoute(path,q){if(path==='/public/settings')return publicSettings();if(path==='/public/plants')return listPublic(q);if(path==='/public/filters')return {habits:rows('Lookup_Habits').filter(x=>String(x.active)==='true').map(x=>x.value),locations:rows('Lookup_Locations').filter(x=>String(x.active)==='true').map(x=>x.value)};if(path==='/public/stats'){const a=visible();return {plants:a.length,species:new Set(a.map(x=>x.scientific_name)).size,families:new Set(a.map(x=>x.family)).size,locations:new Set(a.map(x=>x.location)).size}}let m=path.match(/^\/public\/plants\/(PLT-\d{4,})$/);if(m){const p=plantById(m[1]);if(p.status!=='published')throw apiError('NOT_FOUND','ไม่พบพรรณไม้');return publicPlant(p)}m=path.match(/^\/public\/templates\/([\w-]+)\/preview$/);if(m){const t=templates().find(x=>x.template_id===m[1]);if(!t)throw apiError('NOT_FOUND','ไม่พบ Template');return {template_json:t.template_json,width_mm:t.width_mm,height_mm:t.height_mm}}throw apiError('NOT_FOUND','ไม่พบ API')}
function privateRoute(path,x,u){if(path==='/auth/verify'||path==='/me')return u;if(path==='/me/settings')return publicSettings();if(path==='/me/plants')return myPlants(u,x);if(path==='/me/plant'){const p=plantById(x.id);if(u.role!=='admin'&&p.recorder_email!==u.email)throw apiError('FORBIDDEN','ไม่มีสิทธิ์');return p}if(path==='/plants')return createPlant(u,x);let m=path.match(/^\/plants\/(PLT-\d{4,})(?:\/(images|generate-qr|delete))?(?:\/([\w-]+))?$/);if(m){if(m[2]==='images'&&m[3])return removeImage(u,m[1],m[3]);if(m[2]==='images')return uploadImages(u,m[1],x.images);if(m[2]==='delete')return deletePlant(u,m[1]);if(m[2]==='generate-qr')return {qr_url:plantById(m[1]).qr_url};return updatePlant(u,m[1],x)}if(path==='/admin/templates')return x&&Object.keys(x).length?(allow(u,['admin']),saveTemplate(u,x)):templates();if(path==='/admin/labels/batch-preview')return batchPreview(u,x);if(path==='/admin/labels/print-log')return printLog(u,x);if(path==='/admin/media')return rows('Media').filter(r=>String(r.is_deleted)!=='true').filter(r=>u.role==='admin'||rows('Plants').some(p=>p.plant_id===r.plant_id&&p.recorder_email===u.email)).slice(0,200);allow(u,['admin']);if(path==='/admin/settings')return x&&Object.keys(x).length?saveSettings(u,x):allSettings();if(path==='/admin/users')return x&&Object.keys(x).length?saveUser(u,x):listUsers();if(path==='/admin/activity-log')return rows('Activity_Log').slice(-100).reverse();if(path==='/admin/plants/export')return rows('Plants').filter(p=>String(p.is_deleted)!=='true');m=path.match(/^\/admin\/users\/([\w-]+)(?:\/delete)?$/);if(m)return path.endsWith('/delete')?removeUser(u,m[1]):saveUser(u,x,m[1]);m=path.match(/^\/admin\/templates(?:\/([\w-]+)(\/delete)?)?$/);if(m)return m[2]?deleteTemplate(u,m[1]):saveTemplate(u,x,m[1]);throw apiError('NOT_FOUND','ไม่พบ API')}

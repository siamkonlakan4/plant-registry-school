function publicPlant(p){const o={};for(const k of ['plant_id','plant_code','common_name','scientific_name','family','habit','key_features','location','zone','quantity','latitude','longitude','cover_image_url','image_urls_json','created_at','updated_at','status','qr_url'])o[k]=p[k];if(setting('public_recorder_visibility')==='true')o.recorder_name=p.recorder_name;return o}
function visible(){return rows('Plants').filter(p=>p.status==='published'&&String(p.is_deleted)!=='true')}
function listPublic(q){let a=visible(),term=str(q.q||'',100).toLowerCase();if(term)a=a.filter(p=>['plant_code','common_name','scientific_name','family','location'].some(k=>String(p[k]).toLowerCase().includes(term)));for(const k of ['family','habit','location'])if(q[k])a=a.filter(p=>p[k]===str(q[k],200));const [page,size]=pagination(q);return a.slice((page-1)*size,page*size).map(publicPlant)}
function plantById(id){if(!/^PLT-\d{4,}$/.test(id))throw apiError('INVALID_INPUT','รหัสไม่ถูกต้อง');const p=rows('Plants').find(x=>x.plant_id===id&&String(x.is_deleted)!=='true');if(!p)throw apiError('NOT_FOUND','ไม่พบข้อมูลพรรณไม้');return p}
function myPlants(user,q){const [page,size]=pagination(q);return rows('Plants').filter(p=>String(p.is_deleted)!=='true'&&(user.role==='admin'||p.recorder_email===user.email)).slice((page-1)*size,page*size)}
function createPlant(user,x){return lock(()=>{const data=plantInput(x);uniquePlantCode(data.plant_code);const ids=rows('Plants').map(p=>Number(String(p.plant_id).split('-')[1])||0),id='PLT-'+String(Math.max(0,...ids)+1).padStart(4,'0');const p=append('Plants',{...data,plant_id:id,recorder_email:user.email,recorder_name:user.full_name,created_at:now(),updated_at:now(),status:user.role==='admin'&&['published','draft'].includes(x.status)?x.status:'pending',qr_url:cfg('FRONTEND_URL').replace(/\/?$/,'/')+'#/plant/'+id,label_status:'not_printed',is_deleted:false,image_file_ids_json:'[]',image_urls_json:'[]'});if(x.images?.length)uploadImages(user,id,x.images);audit('create','Plant',id,user,null,p);return p})}
function updatePlant(user,id,x){return lock(()=>{const before=plantById(id);if(user.role!=='admin'&&before.recorder_email!==user.email)throw apiError('FORBIDDEN','แก้ไขได้เฉพาะรายการของตน');const data=plantInput(x);uniquePlantCode(data.plant_code,id);const status=user.role==='admin'&&['draft','pending','published','archived'].includes(x.status)?x.status:before.status;const p=patch('Plants',before,{...data,status,updated_at:now()});if(x.images?.length)uploadImages(user,id,x.images);audit('update','Plant',id,user,before,p);return plantById(id)})}
function deletePlant(user,id){return lock(()=>{const p=plantById(id);if(user.role!=='admin'&&p.recorder_email!==user.email)throw apiError('FORBIDDEN','ไม่มีสิทธิ์');patch('Plants',p,{is_deleted:true,updated_at:now()});audit('delete','Plant',id,user,p,{is_deleted:true});return {plant_id:id}})}

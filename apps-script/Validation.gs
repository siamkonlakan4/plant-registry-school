function str(value,max){const s=String(value??'').trim();if(s.length>max||/[<>\u0000-\u001f]/.test(s))throw apiError('INVALID_INPUT','ข้อความมีอักขระหรือความยาวไม่ถูกต้อง');return s}
function plantInput(x){if(!x||typeof x!=='object')throw apiError('INVALID_INPUT','ข้อมูลไม่ถูกต้อง');const out={};for(const k of ['plant_code','common_name','scientific_name','family','habit','key_features','location','zone','notes'])out[k]=str(x[k],k==='key_features'?2000: k==='notes'?2000:200);for(const k of ['plant_code','common_name','scientific_name','family','habit','key_features','location'])if(!out[k])throw apiError('INVALID_INPUT',k+' จำเป็นต้องกรอก');if(!/^[\p{L}\p{N}_-]{2,40}$/u.test(out.plant_code)||out.scientific_name.split(/\s+/).length<2)throw apiError('INVALID_INPUT','รหัสหรือชื่อวิทยาศาสตร์ไม่ถูกต้อง');out.quantity=Number(x.quantity);if(!Number.isInteger(out.quantity)||out.quantity<1)throw apiError('INVALID_INPUT','จำนวนต้นต้องเป็นจำนวนเต็มบวก');for(const k of ['latitude','longitude']){out[k]=x[k]===''?'':Number(x[k]);if(out[k]!==''&&(!Number.isFinite(out[k])||Math.abs(out[k])>(k==='latitude'?90:180)))throw apiError('INVALID_INPUT','พิกัดไม่ถูกต้อง')}if(x.images&&(!Array.isArray(x.images)||x.images.length>5))throw apiError('INVALID_INPUT','รูปภาพได้สูงสุด 5 รูป');return out}
function uniquePlantCode(code,id){if(rows('Plants').some(p=>String(p.plant_code).toLowerCase()===code.toLowerCase()&&p.plant_id!==id&&String(p.is_deleted)!=='true'))throw apiError('DUPLICATE','รหัสพรรณไม้ซ้ำ')}
function pagination(q){const page=Math.max(1,Math.min(10000,Number(q.page)||1)),size=Math.max(1,Math.min(100,Number(q.pageSize)||20));return [page,size]}

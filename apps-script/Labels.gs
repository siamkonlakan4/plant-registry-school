function batchPreview(user,x){if(!Array.isArray(x.plant_ids)||x.plant_ids.length>100)throw apiError('INVALID_INPUT','เลือกได้สูงสุด 100 รายการ');const t=templates().find(a=>a.template_id===x.template_id);if(!t)throw apiError('NOT_FOUND','ไม่พบ Template');return {template:t,plants:x.plant_ids.map(plantById).filter(p=>user.role==='admin'||p.status==='published').map(publicPlant)}}
function printLog(user,x){return lock(()=>{const t=templates().find(a=>a.template_id===x.template_id);if(!t||!Array.isArray(x.plant_ids)||x.plant_ids.length>100||!['print','pdf'].includes(x.output_type))throw apiError('INVALID_INPUT','คำสั่งพิมพ์ไม่ถูกต้อง');const result=x.plant_ids.map(id=>{const p=plantById(id);const log=append('Label_Print_Log',{print_log_id:uid('PRINT'),template_id:t.template_id,plant_id:id,plant_code:p.plant_code,printed_by_email:user.email,printed_at:now(),print_count:1,output_type:x.output_type,label_status:'printed'});patch('Plants',p,{label_status:'printed',label_printed_at:now()});audit('print','Plant',id,user,null,log);return log});return {count:result.length}})}
